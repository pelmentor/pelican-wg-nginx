worker_processes auto;
daemon off;
pid {{DATA}}/tmp/nginx.pid;
error_log {{DATA}}/logs/nginx-error.log warn;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    client_body_temp_path {{DATA}}/tmp/nginx/client_temp;
    proxy_temp_path {{DATA}}/tmp/nginx/proxy_temp;
    fastcgi_temp_path {{DATA}}/tmp/nginx/fastcgi_temp;
    uwsgi_temp_path {{DATA}}/tmp/nginx/uwsgi_temp;
    scgi_temp_path {{DATA}}/tmp/nginx/scgi_temp;

    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65;
    gzip on;
    gzip_types text/plain text/css application/json application/javascript
               text/xml application/xml image/svg+xml;
    client_max_body_size 100m;

    # Admin panel
    include {{DATA}}/nginx/admin.conf;

    # User content
    include {{DATA}}/nginx/user.conf;
}
