server {
    listen {{ADMIN_PORT}} default_server;
    server_name _;

    root /app/admin/public;
    index index.php;

    # Security headers
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    # Front controller — all routes go through index.php
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # PHP processing
    location ~ \.php$ {
        fastcgi_pass unix:/data/user/tmp/php-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include /etc/nginx/fastcgi_params;
        fastcgi_index index.php;
    }

    # WebSocket proxy — Go server on internal port 6790
    # Nginx upgrades HTTP to WebSocket protocol
    location /ws {
        proxy_pass http://127.0.0.1:6790/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Static assets
    location /assets/ {
        expires 7d;
        add_header Cache-Control "public, immutable";
    }

    # Block access to PHP source
    location /src/ {
        deny all;
    }

    access_log /data/admin/logs/admin-access.log;
    error_log /data/admin/logs/admin-error.log;
}
